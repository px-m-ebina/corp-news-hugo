{
  // Workerの名前。Cloudflareの画面の「Project name」と一致させる
  "name": "corp-news-hugo",
  // Cloudflareの実行環境のバージョン指定
  "compatibility_date": "2026-10-01",
  // 公開する静的ファイルのフォルダ(Hugoの出力先)
  "assets": {
    "directory": "./public"
  },
  // workers.dev のURL(Production)で公開する
  "workers_dev": true,
  // develop などmain以外のブランチ用の確認URL(Preview)を発行する
  "preview_urls": true
}